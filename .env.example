# Copy this file to .env.local and fill in the real value.
# .env.local is gitignored — the real connection string never leaves your machine.

# Supabase → Project Settings → Database → Connection string → Session pooler (URI)
# Remember to replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
