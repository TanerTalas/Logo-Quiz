# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — the real connection string never leaves your machine.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase → Connect → Connection String
#
# Locally, use the Session pooler URI for this and leave MIGRATION_DATABASE_URL
# unset — one connection string is all you need.
#
# In production, point this at the TRANSACTION pooler (port 6543) instead. It
# releases the connection after each transaction rather than holding it for the
# whole session, which is what lets many serverless instances share the free
# tier's 15-client budget.
#
# Remember to replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Only needed once DATABASE_URL points at the transaction pooler: schema changes
# need a session that survives more than one transaction, so `npm run db:push`
# and `npm run db:seed` use this Session pooler URI instead (port 5432).
# MIGRATION_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Round signing
# ---------------------------------------------------------------------------
# Signs the round cookie so a tampered round is rejected. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROUND_SECRET=replace-with-a-long-random-string
